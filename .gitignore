# --- Secretos y configuración local ---
# Los .env contienen credenciales reales: NUNCA deben entrar en Git.
# .env.example sí se versiona (solo plantilla, sin secretos).
.env
.env.*
!.env.example

# --- Python / backend ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node / frontend ---
node_modules/
dist/
coverage/
*.tsbuildinfo

# --- Archivos subidos en desarrollo (CVs, etc.) ---
backend/uploads/

# --- Logs ---
*.log
npm-debug.log*

# --- Sistema operativo y editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/