# Plantilla de variables de entorno del backend.
# Copia este archivo como ".env" y ajusta los valores.
# ".env" ya está cubierto por el .gitignore de la raíz del proyecto.

ENVIRONMENT=development

# Debe coincidir con los datos de docker-compose.yml (raíz del proyecto).
# 127.0.0.1 y no "localhost": en Windows, localhost prueba primero IPv6
# (::1), el contenedor solo escucha en IPv4 y cada conexión nueva tarda
# varios segundos en caer a IPv4.
DATABASE_URL=postgresql+psycopg://sinnoh:change_me@127.0.0.1:5432/cafe_sinnoh

# Base de datos SOLO para los tests (pytest la crea si no existe y la
# vacía tras cada test). Su nombre debe terminar en "_test": si no, los
# tests se niegan a arrancar, para no borrar nunca datos de desarrollo.
TEST_DATABASE_URL=postgresql+psycopg://sinnoh:change_me@127.0.0.1:5432/cafe_sinnoh_test

# Clave usada para firmar los JWT. En desarrollo puede ser cualquier
# cadena; en producción debe ser larga, aleatoria y secreta de verdad.
SECRET_KEY=dev-secret-change-me

# Orígenes desde los que el navegador puede llamar a esta API,
# separados por comas. Es la URL del frontend en desarrollo (Vite).
CORS_ORIGINS=http://localhost:5173

# Duración del access token en minutos. En producción, valores cortos
# (10-30 min) limitan el daño si un token se filtra.
ACCESS_TOKEN_EXPIRE_MINUTES=30