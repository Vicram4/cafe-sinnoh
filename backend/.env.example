# Plantilla de variables de entorno del backend.
# Copia este archivo como ".env" y ajusta los valores.
# ".env" ya está cubierto por el .gitignore de la raíz del proyecto.

ENVIRONMENT=development

# Debe coincidir con los datos de docker-compose.yml (raíz del proyecto).
DATABASE_URL=postgresql+psycopg://sinnoh:change_me@localhost:5432/cafe_sinnoh

# Clave usada para firmar los JWT. En desarrollo puede ser cualquier
# cadena; en producción debe ser larga, aleatoria y secreta de verdad.
SECRET_KEY=dev-secret-change-me

# Orígenes desde los que el navegador puede llamar a esta API,
# separados por comas. Es la URL del frontend en desarrollo (Vite).
CORS_ORIGINS=http://localhost:5173

# Duración del access token en minutos. En producción, valores cortos
# (10-30 min) limitan el daño si un token se filtra.
ACCESS_TOKEN_EXPIRE_MINUTES=30