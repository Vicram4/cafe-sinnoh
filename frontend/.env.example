# Plantilla de variables de entorno del frontend.
# Copia este archivo como ".env" (ya cubierto por el .gitignore de la raíz).
# Vite solo expone al navegador las variables que empiezan por VITE_.

# Ruta relativa: en desarrollo, Vite reenvía /api a uvicorn (vite.config.ts),
# así que web y API comparten origen, como en Docker y en producción.
VITE_API_URL=/api/v1

# "true" muestra el aviso de demo y los botones de cuentas de prueba en el
# login. Las cuentas se crean con: python -m app.seed.seed_demo (en backend/).
VITE_DEMO_MODE=false
