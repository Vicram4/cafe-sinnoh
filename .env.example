# Plantilla de variables de entorno.
# Copia este archivo como ".env" y ajusta los valores.
# ".env" está en .gitignore y no se sube nunca a Git.

# --- PostgreSQL (usado por docker-compose.yml) ---
POSTGRES_USER=sinnoh
POSTGRES_PASSWORD=change_me
POSTGRES_DB=cafe_sinnoh
POSTGRES_PORT=5432

# Más adelante añadiremos aquí las variables del backend
# (DATABASE_URL, SECRET_KEY, etc.) y del frontend.