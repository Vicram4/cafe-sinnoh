# Plantilla de variables de entorno.
# Copia este archivo como ".env" y ajusta los valores.
# ".env" está en .gitignore y no se sube nunca a Git.

# --- PostgreSQL (usado por docker-compose.yml) ---
POSTGRES_USER=sinnoh
POSTGRES_PASSWORD=change_me
POSTGRES_DB=cafe_sinnoh
POSTGRES_PORT=5432

# --- App completa en Docker (docker compose --profile app up -d --build) ---
# Puerto de tu equipo en el que se sirve la web: http://localhost:8080
APP_PORT=8080
# "true" para compilar la web en modo demo (aviso de demo y cuentas de
# prueba en el login). El backend tiene su propio DEMO_MODE en backend/.env.
VITE_DEMO_MODE=false

# El resto de la configuración del backend (SECRET_KEY, etc.) está en
# backend/.env, que también usa el contenedor del backend.